{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "http://local/schemas/document-info",
    "title": "Document Information (Legacy)",
    "description": "Legacy document information schema. Consider using corpus.json instead.",
    "type": "object",
    "properties": {
        "doc_id": {
            "type": "string",
            "description": "Unique document identifier"
        },
        "source": {
            "type": "string",
            "description": "Source system or origin"
        },
        "arxiv_id": {
            "type": "string",
            "description": "ArXiv identifier",
            "pattern": "^\\d{4}\\.\\d{4,5}(v\\d+)?$"
        },
        "path": {
            "type": "string",
            "description": "File system path to document"
        },
        "page_count": {
            "type": "integer",
            "description": "Total number of pages",
            "minimum": 1
        },
        "file_sha256": {
            "type": "string",
            "description": "SHA256 hash of the file",
            "pattern": "^[a-f0-9]{64}$"
        }
    },
    "required": ["doc_id", "source", "path"],
    "additionalProperties": false
}