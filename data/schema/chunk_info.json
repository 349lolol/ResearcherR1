{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "http://local/schemas/chunk-info",
    "title": "Chunk Information (Legacy)",
    "description": "Legacy chunk information schema. Consider using chunks.json instead.",
    "type": "object",
    "properties": {
        "doc_id": {
            "type": "string",
            "description": "Reference to parent document"
        },
        "chunk_id": {
            "type": "string",
            "description": "Unique chunk identifier"
        },
        "page_start": {
            "type": "integer",
            "description": "Starting page number",
            "minimum": 1
        },
        "page_end": {
            "type": "integer",
            "description": "Ending page number",
            "minimum": 1
        },
        "heading_path": {
            "type": "string",
            "description": "Hierarchical heading path"
        },
        "text": {
            "type": "string",
            "description": "Chunk text content"
        }
    },
    "required": ["doc_id", "chunk_id", "text"],
    "additionalProperties": false
}